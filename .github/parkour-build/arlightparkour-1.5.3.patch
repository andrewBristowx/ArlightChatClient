+    private Path worldFolder(String worldName) {
+        Path container = plugin.getServer().getWorldContainer().toPath().toAbsolutePath().normalize();
+        Path folder = container.resolve(worldName).normalize();
+        if (!folder.startsWith(container)) throw new IllegalArgumentException("Nombre de mundo no seguro: " + worldName);
+        return folder;
+    }
+
+    private void writeMarker(Path folder) {
+        try {
+            Files.createDirectories(folder);
+            Files.writeString(folder.resolve(VOID_MARKER), "ArlightParkour void hub 1.5.3\n");
+        } catch (IOException exception) {
+            plugin.getLogger().warning("No se pudo escribir el marcador del mundo vacío: " + exception.getMessage());
+        }
+    }
+
+    private void deleteRecursively(Path folder) {
+        if (!Files.exists(folder)) return;
+        try (var stream = Files.walk(folder)) {
+            stream.sorted(Comparator.reverseOrder()).forEach(path -> {
+                try { Files.deleteIfExists(path); }
+                catch (IOException exception) { throw new WorldDeleteException(exception); }
+            });
+        } catch (WorldDeleteException exception) {
+            throw new IllegalStateException("No se pudo borrar " + folder + ": " + exception.getCause().getMessage(), exception.getCause());
+        } catch (IOException exception) {
+            throw new IllegalStateException("No se pudo recorrer " + folder + ": " + exception.getMessage(), exception);
+        }
+    }
+
+    private static final class WorldDeleteException extends RuntimeException {
+        private WorldDeleteException(IOException cause) { super(cause); }
+    }
