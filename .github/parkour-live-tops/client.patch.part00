+   private static boolean worldMatches(String expected, String current) {
+      if (expected.equalsIgnoreCase(current)) return true;
+      int colon = expected.indexOf(':');
+      return colon >= 0 && expected.substring(colon + 1).equalsIgnoreCase(current);
+   }
+
+   private static void renderGroup(PoseStack pose, MultiBufferSource.BufferSource buffers,
+                                   Vec3 camera, ParkourHubState.GalleryGroup group) {
+      pose.pushPose();
+      try {
+         pose.translate(group.x() - camera.x, group.y() - camera.y, group.z() - camera.z);
+         pose.mulPose(Axis.YP.rotationDegrees(group.yaw()));
+         drawPanelQuad(pose, buffers, textureFor(group.id()));
+         if ("infinite_champion".equals(group.id())) {
+            drawInfinite(pose, buffers, group);
+         } else {
+            drawRanking(pose, buffers, group);
+         }
+      } finally {
+         pose.popPose();
+      }
+   }
+
